# Copy to .env.local and fill in. Never commit real credentials.
# SMTP_PASS must be a Google App Password (16 chars, 2-Step Verification required),
# not the account password: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=healthecy@gmail.com
SMTP_PASS=
# Optional. Gmail only honours the authenticated account or a verified "Send mail as" alias.
SMTP_FROM=Healthecy <healthecy@gmail.com>
# Optional. Defaults to inquiryEmail in lib/site-contact.ts
CONTACT_INBOX=healthecy@gmail.com
